# Copy this file to keystore.properties (same folder, repo root) to enable
# the playRelease build type/signing config in app/build.gradle.kts. That
# file is gitignored - never commit your real keystore.properties or the
# .keystore file it points to.
#
# storeFile can be an absolute path or relative to the repo root.
storeFile=/path/to/dayatlas-play-release.keystore
storePassword=changeme
keyAlias=dayatlas-play
keyPassword=changeme
