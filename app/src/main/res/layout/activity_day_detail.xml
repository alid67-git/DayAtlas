<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_surface">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/md_theme_primary"
            android:minHeight="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/md_theme_on_primary"
            app:titleTextColor="@color/md_theme_on_primary"
            tools:title="Günlük 8 Eyl 2026" />

        <ImageButton
            android:id="@+id/exportButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_export_gpx"
            android:padding="12dp"
            android:src="@drawable/ic_export"
            app:tint="@color/md_theme_on_primary" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="320dp">

                <org.osmdroid.views.MapView
                    android:id="@+id/routeMap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/emptyState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_map_empty_label"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:elevation="4dp"
                    android:text="@string/route_empty"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/md_theme_on_surface"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/jumpsButton"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:text=""
                android:visibility="gone"
                tools:text="Atlamalar (1) — dokunup sil"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/noteRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dash_card"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <TextView
                    android:id="@+id/noteText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="@color/md_theme_on_surface"
                    tools:text="Bugün ailemle yürüyüşe çıktık." />

                <ImageView
                    android:id="@+id/noteIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/day_note_button"
                    android:src="@drawable/ic_note"
                    app:tint="@color/md_theme_on_surface" />
            </LinearLayout>

            <!-- En fazla 3 fotoğraf; dolunca ekle butonu gizlenir. -->
            <LinearLayout
                android:id="@+id/dayPhotosRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/dayPhoto1"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_dash_card"
                    android:contentDescription="@string/day_photo_thumbnail"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <ImageView
                    android:id="@+id/dayPhoto2"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_dash_card"
                    android:contentDescription="@string/day_photo_thumbnail"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/dayPhoto3"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_dash_card"
                    android:contentDescription="@string/day_photo_thumbnail"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/addPhotoButton"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_dash_card"
                    android:contentDescription="@string/day_photo_add"
                    android:padding="16dp"
                    android:src="@drawable/ic_add_photo"
                    app:tint="@color/md_theme_on_surface" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dayStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                tools:itemCount="6"
                tools:listitem="@layout/item_day_stat" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
