<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_surface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_primary"
        android:minHeight="?attr/actionBarSize"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/md_theme_on_primary"
        app:title="@string/action_help"
        app:titleTextColor="@color/md_theme_on_primary" />

    <!-- 8 languages no longer fit as equal-width buttons on one row, so this
         scrolls horizontally like the stats-range chips on the Daily tab. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingTop="16dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/languageGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/langTr"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Türkçe" />

            <com.google.android.material.chip.Chip
                android:id="@+id/langEn"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="English" />

            <com.google.android.material.chip.Chip
                android:id="@+id/langDe"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deutsch" />

            <com.google.android.material.chip.Chip
                android:id="@+id/langZh"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="中文" />

            <com.google.android.material.chip.Chip
                android:id="@+id/langHi"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="हिन्दी" />

            <com.google.android.material.chip.Chip
                android:id="@+id/langEs"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Español" />

            <com.google.android.material.chip.Chip
                android:id="@+id/langFr"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Français" />

            <com.google.android.material.chip.Chip
                android:id="@+id/langAr"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="العربية" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Adım 1: giriş özeti + konu listesi (dokununca ilgili bölüm açılır). -->
    <ScrollView
        android:id="@+id/paneHelpToc"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/helpIntro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/md_theme_on_surface"
                tools:text="DayAtlas, gün boyunca konumunuzu arka planda kaydeden bir uygulamadır." />

            <LinearLayout
                android:id="@+id/helpSectionList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                tools:itemCount="4"
                tools:listitem="@layout/item_help_section" />

            <TextView
                android:id="@+id/helpFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/md_theme_outline"
                tools:text="Geliştiren: Ali Dinçer" />
        </LinearLayout>
    </ScrollView>

    <!-- Adım 2: tek bir bölümün detayı - geri tuşu TOC'a döner. -->
    <ScrollView
        android:id="@+id/paneHelpSection"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/helpSectionHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/md_theme_on_surface"
                android:textStyle="bold"
                tools:text="1) KAYIT MODLARI" />

            <TextView
                android:id="@+id/helpSectionBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/md_theme_on_surface"
                android:textIsSelectable="true"
                tools:text="Günlük mod (önerilen ve varsayılan): Ayarlar'dan açıldığında..." />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
