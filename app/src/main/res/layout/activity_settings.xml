<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_surface">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_primary"
        android:minHeight="?attr/actionBarSize"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@color/md_theme_on_primary"
        app:title="@string/settings"
        app:titleTextColor="@color/md_theme_on_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/dailyMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_daily_mode"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_daily_mode_summary"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/md_theme_outline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/settings_language"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_language_hint"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/md_theme_outline" />

            <RadioGroup
                android:id="@+id/languageGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/languageSystem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/language_system" />

                <RadioButton
                    android:id="@+id/languageTr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/language_tr" />

                <RadioButton
                    android:id="@+id/languageEn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/language_en" />

                <RadioButton
                    android:id="@+id/languageDe"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/language_de" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/settings_interval"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_interval_hint"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <RadioGroup
                android:id="@+id/intervalGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/interval30s"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/interval_30s" />

                <RadioButton
                    android:id="@+id/interval1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/interval_1" />

                <RadioButton
                    android:id="@+id/interval3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/interval_3" />

                <RadioButton
                    android:id="@+id/interval5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/interval_5" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/settings_day_stats"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_day_stats_hint"
                android:textAppearance="?attr/textAppearanceBodySmall" />

            <CheckBox
                android:id="@+id/statCheckDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/map_day_distance" />

            <CheckBox
                android:id="@+id/statCheckLastPoint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/last_point" />

            <CheckBox
                android:id="@+id/statCheckPointCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/point_count" />

            <CheckBox
                android:id="@+id/statCheckGpsInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stat_gps_interval" />

            <CheckBox
                android:id="@+id/statCheckMaxSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stat_max_speed" />

            <CheckBox
                android:id="@+id/statCheckAvgSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stat_avg_speed" />

            <CheckBox
                android:id="@+id/statCheckActiveDuration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stat_active_duration" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/settings_permissions"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/locationSettings"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/open_location_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/batteryExemption"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/request_battery_exemption" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/batterySettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/open_battery_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alarmSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/open_alarm_settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/autostartSettings"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="@string/open_autostart_settings" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/oem_note"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/md_theme_outline" />

            <TextView
                android:id="@+id/filesHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/today_files"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/md_theme_outline" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/settings_drive_backup"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/driveBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_drive_backup_toggle"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_drive_backup_summary"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/md_theme_outline" />

            <TextView
                android:id="@+id/driveFolderLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/md_theme_outline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/drivePickFolder"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/drive_pick_folder" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/driveBackupNow"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/drive_backup_now" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/driveRestoreNow"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/drive_restore_now" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/settings_update"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/versionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/md_theme_outline" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/checkUpdates"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/check_for_updates" />

            <TextView
                android:id="@+id/gpsRateLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/md_theme_outline"
                tools:text="GPS kontrol hızı: 1 dakika" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="@string/app_footer_credit"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/md_theme_outline" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
